# Copy this file to deploy/production.env on the VM, fill in the placeholders,
# and keep that real file readable only by the deployment user. Never commit it.

# Public API hostname. Its DNS A/AAAA record must point to the Oracle VM before Caddy starts.
API_DOMAIN=api.example.com

# Dedicated Neon production database. Keep sslmode=require.
DB_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
DB_USERNAME=<neon-user>
DB_PASSWORD=<set-on-server>

# Exact production frontend origin, without a trailing slash.
CORS_ALLOWED_ORIGIN=https://<your-project>.vercel.app

SPRING_PROFILES_ACTIVE=prod
PORT=8080
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=0
