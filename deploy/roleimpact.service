[Unit]
Description=RoleImpact production services
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/roleimpact
Environment=COMPOSE_PROJECT_NAME=roleimpact
ExecStart=/usr/bin/docker compose --env-file deploy/production.env -f compose.prod.yml up -d --build --remove-orphans
ExecReload=/usr/bin/docker compose --env-file deploy/production.env -f compose.prod.yml up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose --env-file deploy/production.env -f compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
