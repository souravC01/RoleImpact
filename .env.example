# Docker Compose PostgreSQL settings
POSTGRES_DB=roleimpact
POSTGRES_USER=roleimpact
POSTGRES_PASSWORD=roleimpact

# Spring Boot settings (defaults shown)
DB_URL=jdbc:postgresql://localhost:5432/roleimpact
DB_USERNAME=roleimpact
DB_PASSWORD=roleimpact
CORS_ALLOWED_ORIGIN=http://localhost:5173
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Production tuning for a small always-on VM.
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=0

# Leave empty locally to use the Vite /api proxy. On Vercel, set this to the
# public HTTPS backend origin, for example https://api.roleimpact.example.
VITE_API_BASE_URL=
