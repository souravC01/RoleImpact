# Docker Compose PostgreSQL settings
POSTGRES_DB=roleimpact
POSTGRES_USER=roleimpact
POSTGRES_PASSWORD=roleimpact

# Spring Boot settings (defaults shown)
DB_URL=jdbc:postgresql://localhost:5432/roleimpact
DB_USERNAME=roleimpact
DB_PASSWORD=roleimpact
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Frontend setting. Leave empty locally to use the Vite /api proxy.
VITE_API_BASE_URL=
